{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>grafana/grafana-renovate-config//presets/base',
    'github>grafana/grafana-renovate-config//presets/github-actions',
  ],
  customDatasources: {
    kubectl: {
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/kubernetes/kubernetes/releases',
      format: 'json',
      transformTemplates: [
        '{"releases": [$$ [$not(draft) and $not(prerelease) ] . {"version": $substringAfter(tag_name, "v"), "releaseTimestamp": created_at}]}',
      ],
    },
    kustomize: {
      defaultRegistryUrlTemplate: 'https://api.github.com/repos/kubernetes-sigs/kustomize/releases',
      format: 'json',
      transformTemplates: [
        '{"releases": [$$ [$match(tag_name, /kustomize.*/) and $not(draft) and $not(prerelease) ] . {"version": $substringAfter(tag_name, "/v"), "releaseTimestamp": created_at}]}',
      ],
    },
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/Dockerfile/',
      ],
      matchStrings: [
        'ARG KUBECTL_VERSION=(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'custom.kubectl',
      depNameTemplate: 'kubectl',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/Dockerfile/',
      ],
      matchStrings: [
        'ARG HELM_VERSION=(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'helm',
      packageNameTemplate: 'helm/helm',
      extractVersionTemplate: '^v(?<version>.+)$',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/Dockerfile/',
      ],
      matchStrings: [
        'ARG KUSTOMIZE_VERSION=(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'custom.kustomize',
      depNameTemplate: 'kustomize',
      versioningTemplate: 'semver',
    },
  ],
  dependencyDashboard: true,
  enabledManagers: [
    'custom.regex',
    'dockerfile',
    'github-actions',
    'gomod',
    'npm',
  ],
  packageRules: [
    {
      labels: [
        'update-major',
      ],
      matchUpdateTypes: [
        'major',
      ],
    },
    {
      labels: [
        'update-minor',
      ],
      matchUpdateTypes: [
        'minor',
      ],
    },
    {
      automerge: true,
      labels: [
        'automerge-patch',
      ],
      matchUpdateTypes: [
        'patch',
      ],
    },
    {
      labels: [
        'update-digest',
      ],
      matchUpdateTypes: [
        'digest',
      ],
    },
    {
      schedule: '* 0-4 * * 1',
      matchPackageNames: [
        'ghcr.io/renovatebot/renovate',
      ],
    },
    {
      groupName: 'otel',
      groupSlug: 'otel',
      matchFileNames: [
        'go.mod',
        'go.sum',
      ],
      matchPackageNames: [
        'go.opentelemetry.io/**',
      ],
    },
    {
      groupName: 'dagger-otel',
      groupSlug: 'dagger-otel',
      matchFileNames: [
        'dagger/go.mod',
        'dagger/go.sum',
      ],
      matchPackageNames: [
        'go.opentelemetry.io/**',
      ],
    },
    {
      // The otel log modules in dagger/go.mod are pinned by `replace`
      // directives that `dagger develop` regenerates from the Dagger Go
      // SDK's own go.mod (see the `engineVersion` in dagger.json). Any bump
      // Renovate makes here is reverted by the next `make dagger-develop`,
      // which then fails the "Check for drift in Dagger files" workflow.
      // These versions only move when the Dagger engine is upgraded.
      matchFileNames: [
        'dagger/go.mod',
        'dagger/go.sum',
      ],
      matchPackageNames: [
        'go.opentelemetry.io/otel/log',
        'go.opentelemetry.io/otel/sdk/log',
        'go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploggrpc',
        'go.opentelemetry.io/otel/exporters/otlp/otlplog/otlploghttp',
      ],
      enabled: false,
    },
    {
      // Starting with otel v1.47.0, go.opentelemetry.io/otel/internal/global
      // imports go.opentelemetry.io/otel/log. The Dagger Go SDK replaces
      // otel/log with v0.16.0, which imports otel/internal/global in turn,
      // so the build fails with an import cycle. Those replace directives
      // reach every module in go.work, so the root module is capped too.
      // Remove this once the Dagger Go SDK's replace directives are updated.
      matchFileNames: [
        'go.mod',
        'go.sum',
        'dagger/go.mod',
        'dagger/go.sum',
      ],
      matchPackageNames: [
        'go.opentelemetry.io/**',
      ],
      allowedVersions: '<1.47.0',
    },
    {
      matchFileNames: [
        'docs/package.json',
        'docs/pnpm-lock.yaml',
      ],
      groupName: 'Docs',
      groupSlug: 'docs',
    },
    {
      matchPackageNames: [
        'helm/helm',
      ],
      allowedVersions: '<4.0.0',
    },
    {
      matchPackageNames: [
        'kubectl',
      ],
      // TODO: Update this once 1.35 is reaching EOL (Feb 2027)
      allowedVersions: '<1.36.0',
    },
    {
      matchPackageNames: [
        'gopkg.in/yaml.v2',
      ],
      allowedVersions: '<3.0.0',
    },
  ],
}
